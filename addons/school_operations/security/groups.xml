<odoo>
<record id="group_user" model="res.groups"><field name="name">School Staff</field><field name="implied_ids" eval="[(4,ref('base.group_user'))]"/></record>
<record id="group_admissions" model="res.groups"><field name="name">Admissions Officer</field><field name="implied_ids" eval="[(4,ref('group_user'))]"/></record>
<record id="group_accounts" model="res.groups"><field name="name">School Accounts Officer</field><field name="implied_ids" eval="[(4,ref('group_user')),(4,ref('account.group_account_invoice'))]"/></record>
<record id="group_campus_manager" model="res.groups"><field name="name">Campus Manager</field><field name="implied_ids" eval="[(4,ref('group_admissions')),(4,ref('purchase.group_purchase_user')),(4,ref('stock.group_stock_user'))]"/></record>
<record id="group_manager" model="res.groups"><field name="name">School Administrator</field><field name="implied_ids" eval="[(4,ref('group_admissions')),(4,ref('group_accounts')),(4,ref('group_campus_manager')),(4,ref('hr.group_hr_user'))]"/></record>
<record id="base.user_admin" model="res.users"><field name="groups_id" eval="[(4,ref('group_manager'))]"/></record>
</odoo>
