<odoo noupdate="1">
<record id="north" model="school.campus"><field name="name">Fictional North School</field><field name="code">NORTH</field></record><record id="south" model="school.campus"><field name="name">Fictional South School</field><field name="code">SOUTH</field></record>
<record id="session" model="school.session"><field name="name">Fictional Academic Year 2026-27</field><field name="date_start">2026-08-01</field><field name="date_end">2027-07-31</field></record><record id="grade" model="school.grade"><field name="name">Grade 5</field></record>
<record id="north_section" model="school.section"><field name="name">North 5-A</field><field name="campus_id" ref="north"/><field name="grade_id" ref="grade"/></record><record id="south_section" model="school.section"><field name="name">South 5-A</field><field name="campus_id" ref="south"/><field name="grade_id" ref="grade"/></record>
<record id="guardian" model="res.partner"><field name="name">Fictional Guardian One</field><field name="email">guardian@example.invalid</field></record><record id="tuition" model="product.product"><field name="name">Fictional Monthly Tuition</field><field name="type">service</field></record>
<record id="north_plan" model="school.fee.plan"><field name="name">North Grade 5 Demo Fees</field><field name="campus_id" ref="north"/><field name="session_id" ref="session"/><field name="grade_id" ref="grade"/></record><record id="south_plan" model="school.fee.plan"><field name="name">South Grade 5 Demo Fees</field><field name="campus_id" ref="south"/><field name="session_id" ref="session"/><field name="grade_id" ref="grade"/></record>
<record id="north_tuition" model="school.fee.plan.line"><field name="plan_id" ref="north_plan"/><field name="name">Monthly tuition</field><field name="product_id" ref="tuition"/><field name="amount">200</field></record><record id="south_tuition" model="school.fee.plan.line"><field name="plan_id" ref="south_plan"/><field name="name">Monthly tuition</field><field name="product_id" ref="tuition"/><field name="amount">200</field></record>
<record id="application" model="school.application"><field name="campus_id" ref="north"/><field name="student_name">Fictional Student One</field><field name="date_of_birth">2016-04-10</field><field name="guardian_id" ref="guardian"/><field name="session_id" ref="session"/><field name="grade_id" ref="grade"/><field name="section_id" ref="north_section"/></record><record id="document" model="school.application.document"><field name="application_id" ref="application"/><field name="name">Fictional identity checklist</field></record>
</odoo>
